# Copia este archivo a .env.local. Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API). La clave "publishable"/anon es pública: la protege RLS.
# NO uses ni agregues la clave service_role en este proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (canónicas, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publicación. Ambas deben estar AUSENTES en Production hasta que el cliente autorice.
# SITE_INDEXABLE=true      -> permite indexación y sitemap
# ENABLE_STAGE_B=true      -> expone rutas de la Etapa B (solo desarrollo/preview)
